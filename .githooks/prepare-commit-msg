#!/bin/sh
# pre-commit bu commit için bir sürüm yazdıysa mesaja "Surum: <v>" satırı ekler (docs/SURUMLER.md bu satırlardan üretilir).
F="$(git rev-parse --git-dir)/surum-bekleyen"
[ -f "$F" ] || exit 0
read V T < "$F"
[ "$T" = "$(git write-tree 2>/dev/null)" ] || exit 0
git interpret-trailers --in-place --trailer "Surum: $V" "$1"
